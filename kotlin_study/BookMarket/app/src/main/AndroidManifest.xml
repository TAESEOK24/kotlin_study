<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookMarket">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MenuActivity" android:exported="false" />
        <activity
            android:name=".BooksActivity"
            android:exported="false"
            android:theme="@style/Theme.BookMarket.WithActionBar" />
        <activity
            android:name=".BookActivity"
            android:exported="false"
            android:theme="@style/Theme.BookMarket.WithActionBar" />
        <activity
            android:name=".cart.CartActivity"
            android:exported="false"
            android:label="@string/menu_cart"
            android:theme="@style/Theme.BookMarket.WithActionBar" />
        <activity
            android:name=".order.ShippingActivity"
            android:exported="false"
            android:label="배송 정보"
            android:theme="@style/Theme.BookMarket.WithActionBar" />
        <activity
            android:name=".order.OrderActivity"
            android:exported="false"
            android:label="주문 확인"
            android:theme="@style/Theme.BookMarket.WithActionBar" />
        <activity
            android:name=".mypage.MyPageActivity"
            android:exported="false"
            android:label="@string/menu_mypage"
            android:theme="@style/Theme.BookMarket.MyPage" />
        <activity
            android:name=".mypage.MemoActivity"
            android:exported="false"
            android:label="@string/memo_title"
            android:theme="@style/Theme.BookMarket.MyPage"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
